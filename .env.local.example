# Template de variáveis de ambiente para Supabase
# Copie este arquivo para .env.local e preencha os valores locais (NÃO comite .env.local)

# Preferência (server-side - NÃO expor ao client):
# Substitua pelos seus valores locais apenas em .env.local (não versionar)
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY_AQUI - server-only>
SUPABASE_ANON_KEY=<ANON_KEY_AQUI>

# Fallback público (não recomendado para produção):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
